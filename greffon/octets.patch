+/// Atelier : comme `decode_transaction_status_meta_from_frame`, et rend aussi les octets du
+/// compte rendu tels que l'archive les garde, une fois décompressés.
+fn decode_transaction_status_meta_and_bytes_from_frame(
+    slot: u64,
+    reassembled_metadata: Vec<u8>,
+) -> Result<(solana_transaction_status::TransactionStatusMeta, Vec<u8>), SharedError> {
+    if reassembled_metadata.is_empty() {
+        return Ok((
+            solana_transaction_status::TransactionStatusMeta::default(),
+            Vec::new(),
+        ));
+    }
+    // Comme l'original : des octets qui ne sont pas compressés sont décodés tels quels.
+    let decompressed = utils::decompress_zstd(reassembled_metadata.as_slice());
+    let bytes = match decompressed {
+        Ok(decompressed) => decompressed,
+        Err(_) => reassembled_metadata,
+    };
+    let meta = decode_transaction_status_meta(slot, bytes.as_slice()).map_err(|err| {
+        Box::new(std::io::Error::other(format!(
+            "decode transaction metadata (slot {slot}): {err}"
+        ))) as SharedError
+    })?;
+    Ok((meta, bytes))
+}
